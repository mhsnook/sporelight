{
  "name": "sporelight",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "dev:remote": "REMOTE_BINDINGS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:ci": "pnpm db:migrate:remote && wrangler deploy",
    "preview:ci": "pnpm db:migrate:preview && wrangler preview",
    "typecheck": "wrangler types && tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "pnpm db:reset && wrangler d1 execute DB --local --file seed/out/e2e-fixture.sql && playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "seed:build": "node scripts/build-seed.ts",
    "db:seed": "pnpm seed:build && wrangler d1 execute DB --local --file seed/out/seed.sql",
    "db:reset": "rm -rf .wrangler/state && pnpm db:migrate && pnpm db:seed",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc",
    "db:seed:preview": "pnpm seed:build && wrangler d1 execute DB --remote --config wrangler.preview-migrations.jsonc --file seed/out/seed.sql",
    "seed:fetch": "node scripts/fetch-congress.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.27",
    "@fontsource-variable/recursive": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/db": "^0.15.2",
    "@tanstack/react-db": "^0.5.12",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.27",
    "party-db": "^0.2.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
